# ---------------------------------------------------------------------------
# OrbitOps Render integration service. Copy to .env and fill in.
# Runs next to the main backend (backend/, :3001) and the Vercel service
# (:3002), and is only called by the main backend.
# ---------------------------------------------------------------------------

# Where this service listens. Keep 127.0.0.1: only the main backend calls it.
HOST=127.0.0.1
PORT=3003

# Same Postgres as the main backend, but its own schema ("render"). Prisma
# creates the schema on the first `npx prisma migrate deploy`.
DATABASE_URL="postgresql://orbitops:orbitops@127.0.0.1:5433/orbitops?schema=render"

# Seals Render API keys at rest (AES-256-GCM). 32 bytes, base64. Required in
# production. Use a key DIFFERENT from the backend's and the Vercel service's.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared with the main backend ONLY for this service: set the SAME values in
# backend/.env (not the Vercel service's INTERNAL_* values).
# At least 32 characters each. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - RENDER_SERVICE_TOKEN: the main backend sends it on every call here.
# - RENDER_CALLBACK_SECRET: signs the deploy events this service posts back.
RENDER_SERVICE_TOKEN=
RENDER_CALLBACK_SECRET=

# The main backend, for event callbacks (POST /api/internal/provider-events).
MAIN_API_URL=http://localhost:3001

# Optional tuning.
# RENDER_API_BASE=https://api.render.com/v1
# DEPLOY_CONCURRENCY=8
# RENDER_POLL_INTERVAL_MS=3000
# RENDER_DEPLOY_TIMEOUT_MIN=45
# LOG_REQUESTS=1               # Fastify request logging (tokens are redacted)

# Only for `npm run spike` (step 0 of PLAN_PHASE_7). Never commit a real key.
# RENDER_API_KEY=
# SPIKE_REPO=owner/repo
# SPIKE_BRANCH=main
# SPIKE_ROOT_DIR=backend
# SPIKE_OWNER_ID=
