# ---------------------------------------------------------------------------
# OrbitOps Vercel integration service. Copy to .env and fill in.
# Runs next to the main backend (backend/, :3001) and is only called by it.
# ---------------------------------------------------------------------------

# Where this service listens. Keep 127.0.0.1: only the main backend calls it.
HOST=127.0.0.1
PORT=3002

# Same Postgres as the main backend, but its own schema ("vercel"). Prisma
# creates the schema on the first `npx prisma migrate deploy`.
DATABASE_URL="postgresql://orbitops:orbitops@127.0.0.1:5433/orbitops?schema=vercel"

# Seals Vercel tokens at rest (AES-256-GCM). 32 bytes, base64. Required in
# production. Use a DIFFERENT key from the main backend's ENCRYPTION_KEY.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared secrets with the main backend: set the SAME values in backend/.env.
# At least 32 characters each. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# - INTERNAL_SERVICE_TOKEN: the main backend sends it on every call here.
# - INTERNAL_CALLBACK_SECRET: signs the deploy events this service posts back.
INTERNAL_SERVICE_TOKEN=
INTERNAL_CALLBACK_SECRET=

# The main backend, for event callbacks (POST /api/internal/provider-events).
MAIN_API_URL=http://localhost:3001

# Optional tuning.
# VERCEL_API_BASE=https://api.vercel.com
# DEPLOY_CONCURRENCY=8
# VERCEL_POLL_INTERVAL_MS=3000
# VERCEL_DEPLOY_TIMEOUT_MIN=45
# DATA_DIR=./data              # source is extracted under DATA_DIR/work for the upload fallback
# LOG_REQUESTS=1               # Fastify request logging (tokens are redacted)

# Only for `npm run spike` (step 0 of PLAN_PHASE_6). Never commit a real token.
# VERCEL_TOKEN=
# SPIKE_REPO=owner/repo
# SPIKE_REPO_ID=
# SPIKE_BRANCH=main
# SPIKE_ROOT_DIR=frontend
# SPIKE_TEAM_ID=
