# OrbitOps AI service (backend/ai). Loopback only; the main backend is its client.
HOST=127.0.0.1
PORT=3006

# The same Postgres as the other services, in its own schema.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/orbitops?schema=ai

# Shared with backend/.env (AI_SERVICE_TOKEN). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AI_SERVICE_TOKEN=

# OpenAI. Without a key every analysis is rule-based (still useful, clearly labelled).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# OPENAI_TIMEOUT_MS=45000

# Optional limits.
# AI_MAX_INPUT_TOKENS=24000
# AI_MAX_OUTPUT_TOKENS=2500
# AI_RATE_HOUR=20
# AI_RATE_DAY=100
# AI_CACHE_MINUTES=10
# LOG_REQUESTS=1
