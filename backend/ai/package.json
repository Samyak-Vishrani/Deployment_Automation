{
  "name": "orbitops-ai",
  "version": "0.1.0",
  "private": true,
  "description": "OrbitOps AI microservice: diagnoses a project, or one component of it, from its logs and settings with OpenAI (gpt-4o-mini), with a rule-based fallback. Holds the only OpenAI key.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike": "tsx scripts/ai-spike.ts",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@orbitops/integration-common": "file:../integration_common",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "openai": "^4.77.0",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
