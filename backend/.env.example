# ---------------------------------------------------------------- database --
# Matches docker-compose.yml at the repository root. Port 5433, not 5432, so it
# cannot collide with a Postgres already running on the host.
DATABASE_URL="postgresql://orbitops:orbitops@127.0.0.1:5433/orbitops?schema=public"

# ------------------------------------------------------------------ server --
FRONTEND_URL="http://localhost:3000"

# Signs the login session cookie. Required in production; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Encrypts the GitHub tokens stored per user (and, later, env vars). Vercel
# tokens are NOT stored here: the vercel_integration service seals them with its
# own key. Never commit a real value to this example file.
# 32 random bytes, base64. Required in production; generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored token unreadable: users simply reconnect.
ENCRYPTION_KEY=

# ------------------------------------------------------- github sign-in ---
# The GitHub App's OWN client id and a client secret generated on its settings
# page (not a separate OAuth App): one App both signs users in and lists the
# repositories they can connect. On the App's settings page:
#   Callback URL:  http://localhost:3001/api/auth/github/callback
#   [x] Request user authorization (OAuth) during installation
#   [x] Expire user authorization tokens
#   Account permissions -> Email addresses: Read-only
# The callback must point at THIS backend and match GITHUB_OAUTH_CALLBACK_URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ------------------------------------------------------------- github app ---
# Create a GitHub App, install it on the repositories you want to deploy, and
# copy the values here. Never commit the filled-in .env or the .pem.
GITHUB_APP_ID=
# The full PEM, with real newlines written as \n, on a single line.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Optional: pin the installation instead of looking it up per repository.
GITHUB_INSTALLATION_ID=

# The PUBLIC url GitHub delivers to. Must end in /api/webhooks/github and must
# point at THIS backend (port 3001).
#
# If you use a VS Code dev tunnel, set the tunnel's visibility to PUBLIC. A
# private tunnel answers GitHub with a sign-in page, so every delivery fails
# while still looking like it was accepted.
WEBHOOK_CALLBACK_URL=https://your-tunnel.example.com/api/webhooks/github

# ------------------------------------------------------------- deployments --
# Host ports handed out to deployed apps, inclusive.
PORT_RANGE_START=5000
PORT_RANGE_END=5999

# How many builds may run at once. Per-project builds are always serialised
# regardless of this value.
DEPLOY_CONCURRENCY=2

# Build workspaces and deployment logs. Relative paths resolve against the
# backend folder. Keep it short: deep node_modules trees under a long path hit
# Windows' 260-character MAX_PATH limit.
DATA_DIR=./data
