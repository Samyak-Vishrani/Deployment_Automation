{
  "name": "orbitops-logs",
  "version": "0.1.0",
  "private": true,
  "description": "OrbitOps logs microservice: stores every deployment's build log (JSONL), streams it, and tails the running app's logs (Render, Vercel, local Docker) live through the integration services' log proxies.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@orbitops/integration-common": "file:../integration_common",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
