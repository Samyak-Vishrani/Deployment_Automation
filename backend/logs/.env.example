# OrbitOps logs service (backend/logs). Loopback only; the main backend is its client.
HOST=127.0.0.1
PORT=3005

# Shared with backend/.env (LOGS_SERVICE_TOKEN). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LOGS_SERVICE_TOKEN=

# Shared with vercel_integration/.env and render_integration/.env (LOGS_PROXY_TOKEN).
# Accepted ONLY on their /log-proxy routes; it is not their internal token.
LOGS_PROXY_TOKEN=
VERCEL_SERVICE_URL=http://127.0.0.1:3002
RENDER_SERVICE_URL=http://127.0.0.1:3003

# Where build logs are written, and where pre-Phase-12 logs are read from (read-only).
DATA_DIR=./data
LEGACY_LOG_DIR=../data/logs

# Optional tuning.
# MAX_LOG_BYTES=20971520
# RUNTIME_STREAM_MAX_MS=3600000
# RUNTIME_IDLE_MS=900000
# RENDER_RUNTIME_POLL_MS=3000
# MAX_STREAMS_PER_USER=3
# LOG_REQUESTS=1
