generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Terminal and in-flight states of one build-and-run attempt.
enum DeploymentStatus {
  queued
  running
  success
  failed
  cancelled
}

enum DeploymentTrigger {
  push
  manual
  rollback
}

enum AnalysisStatus {
  running
  succeeded
  failed
}

/// What a deployable component is. Decides which provider it may go to.
enum ComponentKind {
  frontend
  backend
  database
}

/// Where a component is deployed. `local_docker` is the existing push-to-deploy
/// path, whose settings still live on Project.
enum ProviderId {
  vercel
  render
  neon
  local_docker
}

enum ComponentStatus {
  draft
  configured
  deploying
  live
  failed
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  /// GitHub avatar, refreshed on every GitHub sign-in.
  avatarUrl    String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  githubConnections GitHubConnection[]
  projects          Project[]

  @@index([email])
}

model GitHubConnection {
  id                    String    @id @default(cuid())
  userId                String
  githubUserId          String?   @db.VarChar(255)
  githubUsername        String?   @db.VarChar(255)
  /// The GitHub App user-to-server token pair, sealed with lib/crypto/secret-box
  /// (`v1.` prefix). Used to ask GitHub which installations and repositories
  /// this user can see. All four are cleared on sign-out and when the user
  /// revokes the App's authorisation on GitHub.
  accessTokenEnc        String?   @db.Text
  refreshTokenEnc       String?   @db.Text
  /// NULL when the App does not expire user tokens.
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, githubUserId])
  @@index([userId])
  @@index([githubUserId])
}

model Project {
  id     String @id @default(cuid())
  userId String
  name   String

  // -------------------------------------------------- repository (phase 3/4) --
  /// Display fields the repository-analysis phase reads. Kept alongside the
  /// deployment fields below rather than folded into them: analysis identifies a
  /// repo by "owner/repo", the push pipeline identifies it by numeric id, and
  /// collapsing the two would make one of the phases lossy.
  githubRepoId   String? @db.VarChar(255)
  githubFullName String? @db.VarChar(255)
  githubUrl      String? @db.Text
  defaultBranch  String? @db.VarChar(255)

  // ----------------------------------------------- push-to-deploy (phase 3) --
  /// Slug. Doubles as the Docker image and container name, so it must be unique
  /// and DNS/CLI safe: lowercase letters, digits and dashes only. Separate from
  /// `name`, which is a human-facing label and is not constrained.
  slug String? @unique

  /// GitHub's numeric repository id. THE routing key for an incoming push.
  /// Chosen over "owner/repo" because it survives renames and transfers, and
  /// because it sidesteps case-sensitivity entirely (GitHub owner/repo are
  /// case-insensitive, but the push payload preserves the creator's casing, so
  /// a string match silently fails on "Samyak/App" vs "samyak/app").
  /// Int, not BigInt. BigInt would make every JSON.stringify of a Project throw,
  /// which is a daily cost for a distant problem. Sizing, measured rather than
  /// assumed: a repo created in 2026 has id ~1.36e9 against Int4's 2.15e9
  /// ceiling, so roughly 0.8e9 of headroom - years, not decades.
  repoId Int?

  /// Display only, and refreshed from every push so a repo rename self-heals.
  repoFullName String?
  owner        String?
  repo         String?

  /// Branch to deploy. NOT normalised - git refs are case-sensitive.
  branch     String?
  autoDeploy Boolean @default(true)

  /// Installation that can mint tokens for this repo. Resolved once at create.
  installationId String?
  /// GitHub webhook id, so deleting the project can remove the hook.
  githubHookId   Int?

  /// Both NULL today; the whole app shares one webhook secret and one callback
  /// URL. Present so per-project secrets become a backfill rather than a
  /// migration plus a route reshape. NULL means "use the global value".
  webhookSecret String?
  callbackPath  String?

  /// Glob patterns. Empty = deploy on any change. Matched with micromatch
  /// against the files touched by the push.
  watchPaths     String[] @default([])
  dockerfilePath String   @default("Dockerfile")
  buildContext   String   @default(".")
  /// Runtime environment for the container. Never passed as --build-arg: build
  /// args are baked into `docker history`.
  envVars        Json     @default("{}")

  /// Port the app listens on inside the container.
  containerPort Int  @default(3000)
  /// Port published on 127.0.0.1. Allocated under an advisory lock; the unique
  /// index is the allocation record. NULL for a project that only ever gets
  /// analysed and never deployed.
  hostPort      Int? @unique

  containerId String?
  /// Last image tag that started successfully.
  currentImageTag String?
  /// The one before it. This is what "rollback" means with plain containers.
  previousImageTag String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  components       ProjectComponent[]
  analyses         Analysis[]
  deployments      Deployment[]
  deployComponents Component[]

  @@unique([userId, githubFullName])
  @@index([userId])
  @@index([githubFullName])
  /// Mirrors the compound WHERE the push handler runs. Deliberately an index
  /// and not a unique constraint: one push fanning out to several projects
  /// (same repo, different Dockerfiles) is a feature, as it is in Dokploy.
  @@index([autoDeploy, repoId, branch])
}

/// One run of the repository analysis, pinned to the commit it read.
///
/// A snapshot rather than a set of rows overwritten in place: the components
/// below are only meaningful for the commit they were detected at, and keeping
/// the last few runs is what lets "re-analyse the same commit" be a lookup.
model Analysis {
  id        String         @id @default(cuid())
  projectId String
  branch    String
  commitSha String
  status    AnalysisStatus @default(running)
  /// "tree" (git tree API + file reads) or "tarball" (fallback for a truncated tree).
  source    String
  /// Skipped folders, unreadable files, truncation: [{ code, message, path? }].
  warnings  Json           @default("[]")
  /// Database usage hint: { detected, engine, evidence, suggestNeon }.
  database  Json?
  error     String?        @db.Text

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  components ProjectComponent[]

  @@index([projectId, createdAt(sort: Desc)])
}

model ProjectComponent {
  id               String   @id @default(cuid())
  projectId        String
  /// NULL only on rows written before analyses were snapshotted.
  analysisId       String?
  type             String   @db.VarChar(100)
  /// "frontend" | "backend" | "unknown"
  role             String?  @db.VarChar(20)
  framework        String?  @db.VarChar(100)
  language         String?  @db.VarChar(100)
  path             String?  @db.VarChar(500)
  packageManager   String?  @db.VarChar(50)
  detectedVersion  String?  @db.VarChar(100)
  confidence       Float?
  installCmd       String?  @db.Text
  buildCmd         String?  @db.Text
  startCmd         String?  @db.Text
  outputDir        String?  @db.VarChar(500)
  runtimeVersion   String?  @db.VarChar(100)
  /// Which files and dependencies triggered the detection.
  evidence         Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([analysisId])
  @@index([type])
  @@index([framework])
}

/// One deployable part of a project, as the user confirmed it.
///
/// Separate from ProjectComponent on purpose. Those rows are analysis output:
/// re-generated on every run and pruned with their snapshot. These are owned by
/// the user and will hold provider resource ids, so re-analysing must never
/// touch them.
model Component {
  id                  String          @id @default(cuid())
  projectId           String
  kind                ComponentKind
  /// Shown on the configure card: "web", "api"...
  name                String          @db.VarChar(100)
  /// Folder within the repository; "." is the root.
  rootDir             String          @default(".") @db.VarChar(500)
  framework           String?         @db.VarChar(100)
  installCmd          String?         @db.VarChar(500)
  buildCmd            String?         @db.VarChar(500)
  startCmd            String?         @db.VarChar(500)
  outputDir           String?         @db.VarChar(500)
  nodeVersion         String?         @db.VarChar(100)
  provider            ProviderId
  /// The provider's id for this component (Vercel project, Render service,
  /// Neon project). Filled in by the provider phases.
  providerResourceId  String?         @db.VarChar(255)
  url                 String?         @db.Text
  status              ComponentStatus @default(draft)
  /// The ProjectComponent this was proposed from. Not a foreign key: that row
  /// is pruned with its analysis snapshot, and this one must outlive it.
  analysisComponentId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([projectId, kind, rootDir])
  @@index([projectId])
}

model Deployment {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status  DeploymentStatus  @default(queued)
  trigger DeploymentTrigger @default(push)

  branch        String
  commitSha     String?
  commitMessage String? @db.Text
  commitAuthor  String?
  /// X-GitHub-Delivery that caused this deployment.
  deliveryId    String?

  imageTag     String?
  errorMessage String? @db.Text
  /// Last 64KB of the build log, captured at terminal state so history survives
  /// log-file cleanup. The live log lives on disk, not here: a TEXT column
  /// appended per line means one UPDATE per line of build output.
  logTail      String? @db.Text

  queuedAt   DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  // ------------------------------------------------ provider deploys (phase 6) --
  /// The component this deploys. NULL for the project-wide local Docker deploys.
  componentId          String?
  /// Who builds and hosts it. Existing rows are local Docker builds.
  provider             ProviderId @default(local_docker)
  /// The provider's own id for this deployment (Vercel's dpl_...).
  providerDeploymentId String?    @db.VarChar(255)
  /// The provider's progress: queued | deploying | building | live | failed | cancelled.
  /// `status` above keeps the five lifecycle values every screen already knows.
  providerStatus       String?    @db.VarChar(20)
  /// "git" (the provider read the repo itself) or "upload" (we sent the files).
  sourceMode           String?    @db.VarChar(10)
  /// This deployment's own URL on the provider.
  url                  String?    @db.Text
  /// The provider's dashboard page for this deployment.
  inspectorUrl         String?    @db.Text
  /// Last event batch applied from the vercel_integration service. Batches at
  /// or below it are redeliveries and are ignored.
  providerEventSeq     Int        @default(0)

  component Component? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  /// The durable idempotency backstop. Postgres treats NULLs as distinct, so
  /// manual deploys (deliveryId NULL) are unlimited, while a GitHub redelivery
  /// arriving after a restart - when the in-memory DeliveryStore is empty -
  /// hits this constraint instead of deploying twice. Catch P2002.
  @@unique([projectId, deliveryId])
  @@unique([provider, providerDeploymentId])
  @@index([projectId, queuedAt(sort: Desc)])
  @@index([componentId, queuedAt(sort: Desc)])
  @@index([status])
}
