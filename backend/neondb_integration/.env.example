# ---------------------------------------------------------------------------
# OrbitOps Neon DB integration service. Copy to .env and fill in.
# Runs next to the main backend (backend/, :3001), the Vercel service (:3002)
# and the Render service (:3003), and is only called by the main backend.
# ---------------------------------------------------------------------------

# Where this service listens. Keep 127.0.0.1: only the main backend calls it.
HOST=127.0.0.1
PORT=3004

# Same Postgres as the main backend, but its own schema ("neon"). Prisma
# creates the schema on the first `npx prisma migrate deploy`.
DATABASE_URL="postgresql://orbitops:orbitops@127.0.0.1:5433/orbitops?schema=neon"

# Seals Neon API keys at rest (AES-256-GCM). 32 bytes, base64. Required in
# production. Use a key DIFFERENT from the backend's and the other services'.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared with the main backend ONLY for this service: set the SAME value in
# backend/.env as NEON_SERVICE_TOKEN. The main backend sends it on every call.
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (No callback secret: this service never calls the backend. Provisioning is synchronous.)
NEON_SERVICE_TOKEN=

# Optional tuning.
# NEON_API_BASE=https://console.neon.tech/api/v2
# NEON_PROVISION_TIMEOUT_MS=60000   # how long POST /databases waits for Neon to finish
# DEFAULT_REGION=aws-us-west-2      # new credentials start with this region (Oregon, next to Render's default)
# DEFAULT_PG_VERSION=17
# LOG_REQUESTS=1                    # Fastify request logging (tokens are redacted)

# Only for `npm run spike` (step 0 of PLAN_PHASE_8). Never commit a real key.
# NEON_API_KEY=
# SPIKE_ORG_ID=
# SPIKE_REGION=aws-us-west-2
